<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Грузавтотранс</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        body { background: #f0f2f5; }
        .hero { background: linear-gradient(135deg, #0d47a1, #1a237e); color: white; padding: 60px 0; }
        .btn-primary { background: #0d47a1; border: none; }
        .btn-primary:hover { background: #1a237e; }
        .card { border-radius: 15px; border: none; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .feature-icon { font-size: 2.5rem; color: #0d47a1; }
    </style>
</head>
<body>

<!-- ШАПКА -->
<nav class="navbar navbar-dark bg-primary">
    <div class="container">
        <span class="navbar-brand"><i class="bi bi-truck"></i> Грузавтотранс</span>
        <div>
            <button class="btn btn-light btn-sm" onclick="showPage('login')">Вход</button>
            <button class="btn btn-outline-light btn-sm" onclick="showPage('register')">Регистрация</button>
        </div>
    </div>
</nav>

<!-- ГЛАВНАЯ -->
<div id="page-home">
    <div class="hero text-center">
        <div class="container">
            <h1><i class="bi bi-truck"></i> Грузавтотранс</h1>
            <p class="lead">Надёжные грузоперевозки по всей России</p>
            <button class="btn btn-light btn-lg mt-3" onclick="showPage('orders')">Мои заказы</button>
        </div>
    </div>
    
    <div class="container my-5">
        <div class="row g-4">
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-shield-check feature-icon"></i>
                    <h5 class="mt-2">Надёжность</h5>
                    <p class="text-muted">Все проверены</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-map feature-icon"></i>
                    <h5 class="mt-2">Навигация</h5>
                    <p class="text-muted">Отслеживание</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-lightning feature-icon"></i>
                    <h5 class="mt-2">Быстро</h5>
                    <p class="text-muted">Моментально</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-3 text-center">
                    <i class="bi bi-file-earmark-text feature-icon"></i>
                    <h5 class="mt-2">Документы</h5>
                    <p class="text-muted">Всё в порядке</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ЗАКАЗЫ -->
<div id="page-orders" style="display:none;">
    <div class="container my-4">
        <h2><i class="bi bi-list-ul"></i> Мои заказы</h2>
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between">
                <div>
                    <h6>Заказ #1245</h6>
                    <p><i class="bi bi-geo-alt"></i> ул. Ленина, 15 - ул. Мира, 78</p>
                    <span class="badge bg-warning">В ожидании</span>
                </div>
                <button class="btn btn-sm btn-outline-primary">Подробнее</button>
            </div>
        </div>
        <div class="card p-3 mb-3">
            <div class="d-flex justify-content-between">
                <div>
                    <h6>Заказ #1244</h6>
                    <p><i class="bi bi-geo-alt"></i> ул. Советская, 5 - ул. Гагарина, 23</p>
                    <span class="badge bg-primary">В пути</span>
                </div>
                <button class="btn btn-sm btn-outline-primary">Подробнее</button>
            </div>
        </div>
        <button class="btn btn-primary w-100 mt-3" onclick="alert('Заказ создан!')"><i class="bi bi-plus-circle"></i> Создать заказ</button>
    </div>
</div>

<!-- РЕГИСТРАЦИЯ -->
<div id="page-register" style="display:none;">
    <div class="container my-4" style="max-width: 600px;">
        <div class="card p-4">
            <h3><i class="bi bi-person-plus"></i> Регистрация</h3>
            <form onsubmit="alert('Регистрация успешна! Код отправлен'); return false;">
                <input type="text" class="form-control mb-2" placeholder="ФИО" required>
                <input type="email" class="form-control mb-2" placeholder="Email" required>
                <input type="tel" class="form-control mb-2" placeholder="Телефон" required>
                <input type="password" class="form-control mb-2" placeholder="Пароль" required>
                <input type="text" class="form-control mb-2" placeholder="Паспорт (серия номер)" required>
                <input type="text" class="form-control mb-2" placeholder="Прописка" required>
                <input type="text" class="form-control mb-2" placeholder="Водительское удостоверение" required>
                <input type="text" class="form-control mb-2" placeholder="ИНН" required>
                <input type="text" class="form-control mb-2" placeholder="Тягач (марка, номер)">
                <input type="text" class="form-control mb-2" placeholder="Прицеп (марка, номер)">
                <select class="form-control mb-2">
                    <option>Перевозчик</option>
                    <option>Заказчик</option>
                </select>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-circle"></i> Зарегистрироваться</button>
            </form>
            <p class="text-center mt-3"><a href="#" onclick="showPage('login')">Уже есть аккаунт? Войти</a></p>
        </div>
    </div>
</div>

<!-- ВХОД -->
<div id="page-login" style="display:none;">
    <div class="container my-4" style="max-width: 400px;">
        <div class="card p-4">
            <h3><i class="bi bi-box-arrow-in-right"></i> Вход</h3>
            <form onsubmit="alert('Добро пожаловать!'); return false;">
                <input type="email" class="form-control mb-2" placeholder="Email" required>
                <input type="password" class="form-control mb-2" placeholder="Пароль" required>
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-key"></i> Войти</button>
            </form>
            <p class="text-center mt-3"><a href="#" onclick="showPage('register')">Нет аккаунта? Регистрация</a></p>
            <p class="text-center text-muted small">Тестовый вход: test@mail.ru / 123456</p>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function showPage(page) {
        document.getElementById('page-home').style.display = 'none';
        document.getElementById('page-orders').style.display = 'none';
        document.getElementById('page-register').style.display = 'none';
        document.getElementById('page-login').style.display = 'none';
        if (page === 'home') document.getElementById('page-home').style.display = 'block';
        else if (page === 'orders') document.getElementById('page-orders').style.display = 'block';
        else if (page === 'register') document.getElementById('page-register').style.display = 'block';
        else if (page === 'login') document.getElementById('page-login').style.display = 'block';
    }
    // Показываем главную
    showPage('home');
</script>
</body>
</html>
